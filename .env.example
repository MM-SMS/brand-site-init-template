# Brand site — environment variables
# Copy to .env.local for local development.

# Cloudflare Turnstile (captcha)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your_turnstile_site_key_here
TURNSTILE_SECRET_KEY=your_turnstile_secret_key_here

# Resend — email delivery
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
RESEND_FORWARD_EMAIL=hello@example.com
RESEND_FROM=Brand Name <noreply@example.com>
RESEND_REPLY_TO=hello@example.com

# Textbelt — SMS outbound (optional)
TEXTBELT_API_KEY=your_textbelt_key_here

# Site URL — used in email template links
SITE_URL=https://example.com

# Subscribe form config — package: github:MM-SMS/opt-in-form-settings-script
# Optional; without these, the package uses built-in defaults
NOTION_TOKEN=secret_xxxxxxxx
NOTION_SUBSCRIBE_FORM_DB_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Payments — package: git+ssh://git@github.com:MM-SMS/payment-script.git#path:packages/orione-pay
# Default custom checkout works without Stripe keys (test card 4242 4242 4242 4242 / 12/29 / 123)
PAYMENT_FLOW=custom
# PAYMENT_FLOW=stripe
# STRIPE_SECRET_KEY=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# STRIPE_ACCOUNT_ID=
# STRIPE_PRICE_ID=
# BINCODES_API_KEY=

# Campaigns / landing-page redirects (when wiring redirections-lp-setup)
# CAMPAIGNS_MNG_URL=
# LINK_PUBLIC_SECRET=
